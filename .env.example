# omino-sso 环境变量模板（与 AGENTS.md §9 一一对应）
# 使用方法：cp .env.example .env

APP_ENV=dev
LOG_LEVEL=info

# ---------- HTTP ----------
HTTP_IDP_ADDR=:8080
HTTP_API_ADDR=:8081
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

# ---------- OIDC ----------
# 必须与外部访问地址完全一致（含端口）
OIDC_ISSUER=http://localhost:8080
OIDC_SIGNING_KEY_PATH=./configs/dev-signing-key.pem
OIDC_SIGNING_KEY_ID=dev-2026-10
# 32 字节密钥：32 位原始字符或 base64(32B)
OIDC_CRYPTO_KEY=0123456789abcdef0123456789abcdef
OIDC_ACCESS_TOKEN_TTL=900
OIDC_REFRESH_TOKEN_TTL=2592000
OIDC_AUTH_CODE_TTL=60

# ---------- 会话 ----------
SESSION_TTL=28800
SESSION_TTL_REMEMBER=604800
# 本地开发留空表示 host-only cookie（localhost 跨端口共享）
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# 可信反代网段（逗号分隔 CIDR/单 IP）；仅这些来源的 X-Forwarded-For 会被采信。
# 留空 = 不信任任何代理（审计 IP 取 RemoteAddr）。生产按实际 LB/nginx 网段填写。
TRUSTED_PROXIES=

# ---------- MySQL ----------
# 注意：本机 3306 若被其它实例占用，docker-compose 映射到 3307
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=omino_dev_pwd
DB_NAME=omino_sso
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ---------- Redis ----------
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 密码哈希 ----------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ---------- 登录策略 ----------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=900
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300
AUDIT_ASYNC_BUFFER=1024

# ---------- 初始化管理员（users 表为空时生效） ----------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345

# ---------- 对象存储（004-object-storage-upload；OSS_PROVIDER 留空 = 不启用上传） ----------
# 启用时 provider 填 aliyun_oss，走 STS AssumeRole（经 ramossrole 角色）签发临时凭证。
# OSS_ACCESS_KEY/OSS_SECRET_KEY 为调用 AssumeRole 的 RAM 用户长期凭证；OSS_ROLE_ARN 必填。
OSS_PROVIDER=aliyun_oss
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=ominono
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# 被扮演角色 ARN（形如 acs:ram::<accountId>:role/ramossrole）
OSS_ROLE_ARN=
# AssumeRole 会话名（可选）
OSS_ROLE_SESSION_NAME=omino-sso
# STS 端点（可选，默认 sts.aliyuncs.com；亦可用 sts.<region>.aliyuncs.com）
OSS_STS_ENDPOINT=sts.aliyuncs.com
# AssumeRole 临时凭证有效期秒（900–43200，默认 3600）
OSS_STS_DURATION_SECONDS=3600
# 对象键前缀（可选，如 sso）
OSS_BASE_PATH=sso
# 公开访问域名（可选，缺省为 https://<bucket>.<endpoint>）
OSS_CUSTOM_DOMAIN=
# 直传凭证（PostObject policy）有效期秒
OSS_CREDENTIAL_TTL=300

# ---------- 短信通道（005-verification-code-auth；留空 = 不启用） ----------
# SMS_PROVIDER: mock（模拟发送，验证码固定 888888，不产生真实短信）/ chuanglan（创蓝）/ 留空 = 关闭
# 生产环境禁止 mock，启动校验会失败。
SMS_PROVIDER=mock
# 创蓝 HTTP 接口地址（SMS_PROVIDER=chuanglan 时必填）
SMS_CHUANGLAN_URL=
SMS_CHUANGLAN_ACCOUNT=
SMS_CHUANGLAN_PASSWORD=
# 模板报备 ID（创蓝 v2/tpl/send 必填，缺它返回 code=130 templateId 不能为空）
# 与下方 TEMPLATE 二选一，二者都为空时启动校验失败。
SMS_CHUANGLAN_TEMPLATE_ID=
# 内容模板文案，仅在未配置 TEMPLATE_ID 时使用（{code} / {s} 会被替换为验证码）
# 例如：【示例】验证码 {code}，5 分钟内有效。
SMS_CHUANGLAN_TEMPLATE=

# ---------- 邮件通道（MAIL_PROVIDER: mock / smtp / 留空 = 关闭） ----------
MAIL_PROVIDER=mock
MAIL_SMTP_HOST=
# 465 = SMTPS（连上即 TLS）；587/25 = 明文 + STARTTLS
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# 发件人（From 头），形如 "omino-sso <no-reply@example.com>"
# 信封发件人（MAIL FROM）在 MAIL_SMTP_USERNAME 为邮箱形态时自动用它，
# 否则 126/163 会回 "553 Mail from must equal authorized user"。
MAIL_FROM=
# 验证码邮件模板（html/template），随项目文件发布
MAIL_TEMPLATE_PATH=./configs/verify-mail.tmpl

# ---------- 验证码策略与清理 ----------
# 验证码有效期（秒，默认 300）
VERIFY_CODE_TTL=300
# 同一目标重发间隔（秒，默认 60，必须小于 VERIFY_CODE_TTL）
VERIFY_RESEND_INTERVAL=60
# 单个验证码最大连续错误次数（超限立即失效，默认 5）
VERIFY_MAX_ATTEMPTS=5
# 供应商熔断：同一渠道连续失败达到阈值即短路，冷却期内请求直接失败且不调用供应商
# （阈值设为 0 关闭熔断；阈值 > 0 时冷却必须 > 0）
VERIFY_CIRCUIT_THRESHOLD=5
VERIFY_CIRCUIT_COOLDOWN=60
# 发送记录与审计日志保留天数（默认 180，内置定时任务每日清理）
VERIFY_RECORD_RETENTION_DAYS=180
