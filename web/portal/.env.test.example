# 门户前端构建期配置 —— test（四域：portal / admin / api / sso 各一个子域）
#
# 用法：cp .env.test.example .env.test && make build-web WEB_MODE=test
# 把 example-test.com 换成本环境主域（三处域名必须同主域，cookie 才能跨子域共享）。

VITE_API_BASE_URL=/api/v1

# 管理后台入口：必须是绝对地址，且 origin 会被门户的 next 白名单信任
VITE_ADMIN_HOME=https://admin.example-test.com/users

VITE_SITE_NAME=统一身份认证（测试）
