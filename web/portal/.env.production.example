# 门户前端构建期配置 —— prod
#
# 用法：cp .env.production.example .env.production && make build-web
# 把 example.com 换成本环境主域（三处域名必须同主域，cookie 才能跨子域共享）。

VITE_API_BASE_URL=/api/v1

# 管理后台入口：必须是绝对地址，写错会让"登录后进后台"跳到不存在的路径
VITE_ADMIN_HOME=https://admin.example.com/users

# 统一身份登录域（未登录 SSO 的回跳白名单）；必须是本环境的 sso 子域
VITE_SSO_BASE_URL=https://sso.example.com

VITE_SITE_NAME=统一身份认证
