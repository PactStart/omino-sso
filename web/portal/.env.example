# 门户前端构建期配置 —— dev（vite dev / 本地预览，默认即可用）
#
# 三套环境各用一份模板，避免"改一处忘另一处"；真实文件（.env / .env.test / .env.production）不入库：
#   .env.example             dev   → 本文件，可直接用，或 cp 为 .env
#   .env.test.example        test  → cp 为 .env.test 后 `make build-web WEB_MODE=test`
#   .env.production.example  prod  → cp 为 .env.production 后 `make build-web`
#
# 三套环境都是同源反代（前端 nginx 把 /api/ 转发到 api 域），
# 因此 VITE_API_BASE_URL 恒为 /api/v1；差异只在跨域的绝对地址。

# API 基地址：同源反代用相对路径；跨域直连才写绝对地址
VITE_API_BASE_URL=/api/v1

# 管理后台入口：admin 是独立产物、独立入口，路由挂根路径（/users，不带 /admin 前缀）
# dev 是 5174 端口；test/prod 必须注入 admin.<主域> 的绝对地址
VITE_ADMIN_HOME=http://localhost:5174/users

# 站点名（登录页标题等）
VITE_SITE_NAME=统一身份认证
