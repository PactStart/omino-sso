# 管理后台构建期配置 —— prod
#
# 用法：cp .env.production.example .env.production && make build-web
# 把 example.com 换成本环境主域（三处域名必须同主域，cookie 才能跨子域共享）。

VITE_API_BASE_URL=/api/v1

# 门户账号中心（「返回门户」）
VITE_PORTAL_HOME=https://portal.example.com/account/profile

# 门户登录页：会话失效时整页跳这里，并带上当前后台页面的绝对地址作为 next
VITE_PORTAL_LOGIN_URL=https://portal.example.com/login

VITE_SITE_NAME=统一身份认证
