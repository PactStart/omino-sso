# 管理后台构建期配置 —— dev（vite dev / 本地预览，默认即可用）
#
# 三套环境各用一份模板，真实文件（.env / .env.test / .env.production）不入库：
#   .env.example             dev   → 本文件，可直接用，或 cp 为 .env
#   .env.test.example        test  → cp 为 .env.test 后 `make build-web WEB_MODE=test`
#   .env.production.example  prod  → cp 为 .env.production 后 `make build-web`
#
# admin 的路由挂根路径（/users、/clients…），dev 5174 与 test/prod 的 admin.<主域> 行为一致；
# 与门户之间是跨域跳转，所以下面两个门户地址必须写**绝对地址**。

# API 基地址：同源反代用相对路径（前端 nginx 把 /api/ 转发到 api 域）
VITE_API_BASE_URL=/api/v1

# 门户「账号中心」（顶部菜单「返回门户」）
VITE_PORTAL_HOME=http://localhost:5173/account/profile

# 未登录 / 会话失效时跳转的门户登录页（回跳 next 会自动补成当前后台页面的绝对地址）
VITE_PORTAL_LOGIN_URL=http://localhost:5173/login

# 站点名
VITE_SITE_NAME=统一身份认证
