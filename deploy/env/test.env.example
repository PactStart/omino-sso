# 测试环境环境变量模板
#
# 用法：
#   cp deploy/env/test.env.example /etc/omino-sso/test.env
#   chmod 600 /etc/omino-sso/test.env     # 真实值不入库，只放部署机
#   docker compose -f deploy/compose.test.yml --env-file /etc/omino-sso/test.env up -d
#
# 本文件同时给两处用：① 容器运行时环境（env_file）② compose 插值（IMAGE_TAG / 端口 / API_UPSTREAM）。
# 所有 example.com 必须替换为本环境真实主域，四个子域必须同主域（cookie 才能跨子域共享）。

# ---------- 编排插值 ----------
# 三镜像同 tag（<版本或日期>-<序号>）；回滚时整体改回旧 tag
IMAGE_TAG=2026.10.23-1
# 前端 nginx → api 域；指向内网入口（api.<主域> 或内网 LB），不是 sso:8081
API_UPSTREAM=http://api.test.example.com
# 公网站点监听：LB 直连或宿主机 nginx 反代
FRONTEND_BIND_ADDR=0.0.0.0
PORTAL_HOST_PORT=8088
ADMIN_UI_HOST_PORT=8090
# 后端端口只绑回环/内网：8080 给 sso 域入口，8081 给 api 域入口；禁止 0.0.0.0
SSO_IDP_BIND_ADDR=127.0.0.1
SSO_IDP_HOST_PORT=8080
SSO_API_BIND_ADDR=127.0.0.1
SSO_API_HOST_PORT=8081

# ---------- 应用 ----------
APP_ENV=test
LOG_LEVEL=info
HTTP_IDP_ADDR=:8080
HTTP_API_ADDR=:8081
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

# ---------- OIDC ----------
# 必须是外部访问地址（sso 域，无尾斜杠），与 token 的 iss 完全一致
OIDC_ISSUER=https://sso.test.example.com
# 容器内路径：由 compose 把宿主 /etc/omino-sso/signing-key.pem 只读挂载到这里
OIDC_SIGNING_KEY_PATH=/run/secrets/signing-key.pem
OIDC_SIGNING_KEY_ID=2026-10
# 32 字节密钥（32 位原始字符或 base64(32B)）；轮换会导致 TOTP 等加密字段不可解密
OIDC_CRYPTO_KEY=
OIDC_ACCESS_TOKEN_TTL=900
OIDC_REFRESH_TOKEN_TTL=2592000
OIDC_AUTH_CODE_TTL=60

# ---------- 会话 ----------
SESSION_TTL=28800
SESSION_TTL_REMEMBER=604800
# 必须是主域且带前导点：cookie 要能被 portal / admin / sso 三个子域共同读取
COOKIE_DOMAIN=.test.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# 未登录 SSO 的落点：门户登录页（test 允许留空=回落内置页，非空必须 https）
PORTAL_LOGIN_URL=https://portal.test.example.com/login

# ---------- 可信反代（审计 IP 的唯一来源） ----------
# 逗号分隔 CIDR/单 IP。必须列全**三段**，漏一段不会报错，只会静默把审计 IP 记成容器网段：
#   ① 入口 LB 网段        例：10.0.0.0/24
#   ② 前端容器网段        例：172.18.0.0/16（portal/admin 的 nginx 也是反代的一跳）
#   ③ api 入口网段        例：172.18.0.0/16 或 10.0.1.0/24
# 反证方法（quickstart §4）：临时去掉②，登录一次，审计 ip 应变成 172.x；加回后恢复真实 IP。
TRUSTED_PROXIES=10.0.0.0/24,172.18.0.0/16

# ---------- MySQL（云实例，VPC 内网） ----------
DB_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=omino_sso
DB_PASSWORD=
DB_NAME=omino_sso
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ---------- Redis（云实例，内网、无 TLS、只配密码） ----------
REDIS_ADDR=r-xxxxxxxx.redis.rds.aliyuncs.com:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 密码哈希与登录策略 ----------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=900
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300
AUDIT_ASYNC_BUFFER=1024

# ---------- 初始化管理员（users 表为空时生效；建成后建议清空本项） ----------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 短信通道（测试可 mock） ----------
# mock=固定 888888 不真实发送；chuanglan=创蓝；留空=关闭
SMS_PROVIDER=mock
SMS_CHUANGLAN_URL=https://smssh1.253.com/msg/v2/tpl/send
SMS_CHUANGLAN_ACCOUNT=
SMS_CHUANGLAN_PASSWORD=
SMS_CHUANGLAN_TEMPLATE_ID=
SMS_CHUANGLAN_TEMPLATE=

# ---------- 邮件通道（测试可 mock） ----------
# mock / smtp；465=SMTPS，587/25=明文+STARTTLS
MAIL_PROVIDER=mock
MAIL_SMTP_HOST=smtp.exmail.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM="omino-sso <no-reply@test.example.com>"
MAIL_TEMPLATE_PATH=/app/configs/verify-mail.tmpl

# ---------- 对象存储（留空 OSS_PROVIDER 即关闭上传） ----------
OSS_PROVIDER=
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ROLE_ARN=
OSS_ROLE_SESSION_NAME=omino-sso
OSS_STS_ENDPOINT=sts.aliyuncs.com
OSS_STS_DURATION_SECONDS=3600
OSS_BASE_PATH=sso
OSS_CUSTOM_DOMAIN=
OSS_CREDENTIAL_TTL=300

# ---------- 验证码策略与清理 ----------
VERIFY_CODE_TTL=300
VERIFY_RESEND_INTERVAL=60
VERIFY_MAX_ATTEMPTS=5
VERIFY_CIRCUIT_THRESHOLD=5
VERIFY_CIRCUIT_COOLDOWN=60
VERIFY_RECORD_RETENTION_DAYS=180
