# 本地配置与密钥
.env
configs/*.pem
bin/

# 文档生成中间产物（swag 的 Swagger 2.0 输出）
.tmp/

# Spec Kit 机器本地评估产物（not meant to be shared）
.specify/assessments

# 前端
web/*/node_modules/
web/*/dist/
web/dist/
# 按环境构建的前端配置（模板为 web/*/.env*.example，入库）
web/*/.env.local
web/*/.env.development
web/*/.env.test
web/*/.env.production
# 部署机真实 env（模板为 deploy/env/*.env.example，入库）
deploy/env/*.env
deploy/env/*.env.*
!deploy/env/*.env.example
*.log
.DS_Store

# Playwright CLI 本地会话产物
.playwright-cli/

# 示例工程产物（008-integration-examples）
examples/python/venv/
examples/python/.venv/
examples/**/__pycache__/
examples/java/target/
*.pyc
# go build 产物（示例一律 go run .，二进制不入库）
examples/go/go
